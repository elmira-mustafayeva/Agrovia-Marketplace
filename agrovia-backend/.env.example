# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# JWT
JWT_SECRET=<generate a long random hex string>
JWT_EXPIRE=7d

# Admin secret (used to guard admin-only registration routes if applicable)
ADMIN_SECRET_KEY=<strong random secret>

# Cloudinary (image/video storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend origin (CORS and email links)
FRONTEND_URL=http://localhost:5175

# Google Maps (used for delivery distance calculation)
GOOGLE_MAPS_API_KEY=

# Email (Nodemailer — SMTP)
# For development use Mailtrap (https://mailtrap.io) or Ethereal (https://ethereal.email)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Agrovia" <noreply@agrovia.az>

# OTP settings
OTP_EXPIRE_MINUTES=10

# Stripe (card payments)
# Get keys from https://dashboard.stripe.com/apikeys
# Use sk_test_... keys for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...
# Get from Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin seed values (required by: npm run seed:admin)
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
